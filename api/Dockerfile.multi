# syntax=docker/dockerfile:1

# --- Étape deps : installe uniquement les dépendances de prod ---
FROM node:22.11-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# Le .npmrc (token registre) est monté le temps du RUN : il n'entre dans aucun layer.
# Sans --secret au build, le montage est simplement absent et npm ci marche quand même.
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc npm ci --omit=dev

# --- Étape runtime : image finale minimale, non-root ---
FROM node:22.11-alpine AS runtime
WORKDIR /app
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node server.js db.js package.json ./
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
