# Copier en .env (non commité) : cp .env.example .env
# Ces valeurs servent à l'interpolation ${} de compose.yml.

# Utilisateur et base PostgreSQL (créés au premier démarrage)
POSTGRES_USER=demo
POSTGRES_DB=demo

# Ports publiés sur l'hôte
API_PORT=8080
ADMINER_PORT=8081

# Le mot de passe n'est PAS ici : il est dans ./secrets/db_password.txt
# (Docker Secrets, voir README).
